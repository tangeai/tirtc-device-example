From 6c8f02580761e6f3991975e36b14aaf8b808bf05 Mon Sep 17 00:00:00 2001
From: wangty <wangtianyuan@tange.ai>
Date: Sat, 4 Jul 2026 15:10:29 +0800
Subject: [PATCH] local: keep ESP32 S3/P4 delivery fixes

Keep local delivery-only fixes on top of upstream master: use ESP-IDF task stack caps for ESP32-S3/P4 task stacks while leaving task control ownership to IDF, and use the ESP32-P4 hw_ver1 register include path required by ESP-IDF 5.5.4.
---
 esp32p4.mak              |  2 +-
 platform/plat_freertos.c | 46 +++++++++++++++++-----------------------
 2 files changed, 21 insertions(+), 27 deletions(-)

diff --git a/esp32p4.mak b/esp32p4.mak
index b7a59f1..fe0e784 100644
--- a/esp32p4.mak
+++ b/esp32p4.mak
@@ -51,7 +51,7 @@ EXTRA_CFLAGS := \
 	-I$(COMPPATH)/soc/include \
 	-I$(COMPPATH)/soc/esp32p4 \
 	-I$(COMPPATH)/soc/esp32p4/include \
-	-I$(COMPPATH)/soc/esp32p4/register \
+	-I$(COMPPATH)/soc/esp32p4/register/hw_ver1 \
 	-I$(COMPPATH)/hal/platform_port/include \
 	-I$(COMPPATH)/hal/esp32p4/include \
 	-I$(COMPPATH)/hal/include \
diff --git a/platform/plat_freertos.c b/platform/plat_freertos.c
index b5999a5..e8ced3a 100644
--- a/platform/plat_freertos.c
+++ b/platform/plat_freertos.c
@@ -7,15 +7,14 @@
 
 #include "logfile.h"
 
-#ifdef __ESP32S3__
-#define STACK_IN_PSRAM 1
+#if defined(ESP_PLATFORM) && (defined(__ESP32S3__) || defined(__ESP32P4__))
+#include "freertos/idf_additions.h"
+#include "esp_heap_caps.h"
+#define TIRTC_IDF_TASK_STACK_CAPS (MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT)
 #endif
 
 typedef struct freeRTOSThreadWrapper {
     TaskHandle_t handle;
-#ifdef STACK_IN_PSRAM
-    StaticTask_t *tcb;
-#endif
 
     SA_EVENT evtTerm;
     SA_BOOL detached;
@@ -43,7 +42,11 @@ static void task_entry(void *param)
     LogD("h=%p, h->routine=%p, h->arg=%p, name=%s\n", h, h->routine, h->arg, pcTaskGetName(h->handle));
     if(!h->routine) {
         _err("task_entry: NULL routine for task %s\n", pcTaskGetName(h->handle));
+#ifdef TIRTC_IDF_TASK_STACK_CAPS
+        vTaskDeleteWithCaps(NULL);
+#else
         vTaskDelete(NULL);
+#endif
         return;
     }
     h->routine(h->arg);
@@ -74,12 +77,13 @@ static void task_entry(void *param)
     SA_MutexUnlock(_tl_lock_);
     if (self_detached) {
         SA_EventUninit(h->evtTerm);
-#ifdef STACK_IN_PSRAM
-        free(h->tcb);
-#endif
         free(h);
     }
+#ifdef TIRTC_IDF_TASK_STACK_CAPS
+    vTaskDeleteWithCaps(NULL);
+#else
     vTaskDelete(NULL);
+#endif
 }
 
 SA_BOOL freertos_ThreadCreateWithStackSize(SA_HTHREAD *ph, SA_ThreadRoutine routine, void *arg, int stack_size, const char *name)
@@ -103,20 +107,14 @@ SA_BOOL freertos_ThreadCreateWithStackSize(SA_HTHREAD *ph, SA_ThreadRoutine rout
     stack_size /= 2; //stack_size /= sizeof(StackTypye_t);
 #endif
 
-#ifdef STACK_IN_PSRAM
-#ifdef __ESP32S3__
-    StackType_t *stack = (StackType_t*)heap_caps_malloc(stack_size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
-    h->tcb = heap_caps_malloc(sizeof(StaticTask_t), MALLOC_CAP_INTERNAL);
-    if(!stack || !h->tcb) {
-        _err("freertos_ThreadCreateWithStackSize: PSRAM/internal alloc failed for %s (stack=%p tcb=%p)\n", name, stack, h->tcb);
-        free(stack); free(h->tcb); h->tcb = NULL;
-        SA_EventUninit(h->evtTerm); free(h);
-        return SA_FALSE;
-    }
-    h->handle = xTaskCreateStatic(task_entry, name, stack_size, h, configMAX_PRIORITIES/2, stack, h->tcb);
-    if(!h->handle) _err("xTaskCreateStatic failed\n");
-    BaseType_t ret = h->handle ? pdPASS : errCOULD_NOT_ALLOCATE_REQUIRED_MEMORY;
-#endif
+#ifdef TIRTC_IDF_TASK_STACK_CAPS
+    BaseType_t ret = xTaskCreateWithCaps(task_entry,
+                                         name,
+                                         stack_size,
+                                         h,
+                                         configMAX_PRIORITIES/2,
+                                         &h->handle,
+                                         TIRTC_IDF_TASK_STACK_CAPS);
 #else
     BaseType_t ret = xTaskCreate(task_entry, name, stack_size, h, configMAX_PRIORITIES/2, &h->handle);
 #endif
@@ -140,9 +138,6 @@ SA_BOOL freertos_ThreadCreateWithStackSize(SA_HTHREAD *ph, SA_ThreadRoutine rout
         _err("xTaskCreate: %d\n", (int)ret);
     }
     SA_EventUninit(h->evtTerm);
-#ifdef STACK_IN_PSRAM
-    free(h->tcb);
-#endif
     free(h);
     return SA_FALSE;
 }
@@ -199,4 +194,3 @@ int SA_ThreadResume(SA_HTHREAD h)
     return 0;
 }
 #endif //USE_FREERTOS_TASK
-
-- 
2.43.0

